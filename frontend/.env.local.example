# D-Cloud Frontend — Local Environment Overrides
# Rename this file to .env.local and fill in the values.
#
# VITE_BRIDGE_URL
#   Set this ONLY on machines 2 & 3 (or any machine that is NOT running the bridge).
#   Point it at the LAN IP of the machine running the Python bridge (api-bridge/main.py).
#
#   Example:
#     VITE_BRIDGE_URL=http://192.168.1.100:3000
#
#   Machine 1 (the bridge host) does NOT need this — it defaults to http://127.0.0.1:3000
#
# VITE_BRIDGE_URL=http://<BRIDGE_MACHINE_LAN_IP>:3000
