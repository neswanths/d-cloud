# ─── D-Cloud Bridge Configuration ────────────────────────────────────────────
# Copy this to .env and set your actual node IPs.

# Comma-separated HTTP URLs for each D-Cloud node server.
# Replace with the actual IP addresses of your 3 machines.
# Example (3 machines on the same LAN):
NODE_URLS=http://192.168.1.10:8001,http://192.168.1.11:8001,http://192.168.1.12:8001

# For LOCAL TESTING (all on one machine, different ports):
# NODE_URLS=http://127.0.0.1:8001,http://127.0.0.1:8002,http://127.0.0.1:8003

# Chunk size in bytes (64 KB default)
CHUNK_SIZE=65536

# Number of nodes data is replicated to (informational)
REDUNDANCY_FACTOR=3

# Port the FastAPI bridge listens on
APP_PORT=3000
